bp 1

name        Basic Wooden House
author      TiozinNub
version     3
orientation all
flippable   true

materials
  1 option overworld_wood
  2 option overworld_wood
  3 option any_color

groups
  beds required  1 2 4 6
  base optional  lv1 lv2 lv3
  attic optional  has
  beds.4 needs attic.has
  beds.6 needs attic.has

legend
  o $1 log
  - $1 log[axis=x]
  | $1 log[axis=z]
  # $2 planks
  S $2 stairs[facing=east]
  d $1 door[facing=east,hinge=right]
  F $2 fence
  O $1 door[facing=east,half=upper,hinge=right]
  * wall_torch[facing=south]
  W wall_torch
  s $2 stairs[facing=west,half=top]
  T $2 stairs[facing=east,half=top]
  t $2 stairs[facing=west]
  A $2 stairs[facing=south,half=top]
  a $2 stairs[half=top]
  L $2 slab
  B $3 bed
  b $3 bed[part=foot]
  C crafting_table
  c chest[type=left]
  H chest[type=right]
  f furnace
  h chest[facing=west,type=right]
  E chest[facing=west,type=left]
  l ladder

