  | $1 log[axis=z]
  # $1 planks
  G glass
  D $1 door[facing=north,hinge=right]
  * torch
  B $2 bed[facing=north]
  b $2 bed[facing=north,part=foot]
  W crafting_table
  T $1 trapdoor[half=top]
  L ladder[facing=north]
  C chest[facing=south]
  c cobblestone

