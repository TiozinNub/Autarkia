// The fixture rule is local: a main part's partner cell is air or its matching part, and every
// other part lands on some main part's partner cell. These beds face north, so a foot is south.
bp 1

name        fixtures
author      test
version     1
orientation all
flippable   false

materials
  1 option any_color

legend
  # stone
  B $1 bed[facing=north]
  b $1 bed[facing=north,part=foot]
  D oak_door

layer 0
  #######
  #######
  #######

layer 1
  #B....#         // expect error fixture_collision
  #B.b..#         // expect error fixture_lonely
  #..D..#         // expect error fixture_collision

layer 2
  #.....#
  #.....#
  #..#..#
