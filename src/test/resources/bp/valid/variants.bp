// A hut that grows: a required group, two optional ones, a need, a variant drawn below the base,
// and one that changes cells the variant it needs drew.
bp 1

name        growing hut
author      test
version     1
orientation all
flippable   true

materials
  1 option oak|spruce

groups
  wing   optional  east
  beds   required  one two three
  cellar optional  storage
  beds.three needs wing.east

legend
  # stone
  P $1 planks
  D $1 door[facing=north,hinge=right]
  T $1 trapdoor[half=top]
  B red_bed[facing=south]
  b red_bed[facing=south,part=foot]

